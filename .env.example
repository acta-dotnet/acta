# Local dev connection strings for the Postgres / SQL Server path. You do NOT need this file to
# run concepts and demos: with no ACTA_LOCAL_PROVIDER set they default to embedded SQLite, which
# needs no server and no connection string. Copy to .env (gitignored) only when you want to run
# against a real server instead.
#
# Postgres and SQL Server both use password auth locally (docker-compose), matching production.
# SQL Server is opt-in via ACTA_LOCAL_PROVIDER=sqlserver.
# Everyday work uses the acta-dev database; the conformance tests use acta-test
# (set in tests/Acta.runsettings), so they never touch acta-dev.

ACTA_TEST_PG=Host=localhost;Port=5432;Database=acta-dev;Username=postgres;Password=AbitMOREsecure_PASSWORD
# 127.0.0.1, not localhost: compose binds the container to IPv4 loopback only, and SqlClient
# resolves localhost to ::1 first and times out instead of falling through.
ACTA_TEST_MSSQL=Server=127.0.0.1,1433;Initial Catalog=acta-dev;User=sa;Password=AbitMOREsecure_PASSWORD;TrustServerCertificate=true
ACTA_TEST_REDIS=localhost:6379

# Provider for concepts and the lab: sqlite (default, embedded, no docker) | postgres | sqlserver.
# Uncomment to opt concepts/demos into a server; leave unset for the zero-setup SQLite default.
# ACTA_LOCAL_PROVIDER=postgres

# Host ports for docker-compose (change if you already run a server on the default port,
# then update the connection strings above to match):
# ACTA_PG_PORT=5432
# ACTA_MSSQL_PORT=1433
# ACTA_REDIS_PORT=6379
