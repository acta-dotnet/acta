<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Trim and AOT analyzers on: a registration that hides a constructor from the trimmer fails the build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Acta.Postgres</RootNamespace>
    <Description>PostgreSQL provider for Acta: store, dialect, parameter binding, and migrations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acta.Runtime\Acta.Runtime.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Acta.Generators\Acta.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Acta.Tests.Conformance.Postgres" />
    <InternalsVisibleTo Include="Anvil.Bench" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <!-- The ordered migrations; every other SQL file lives beside its operation in Acta.Runtime. -->
    <EmbeddedResource Include="Schema/Migrations/**/*.sql" Exclude="$(DefaultItemExcludes)">
      <LogicalName>$(AssemblyName).$([MSBuild]::ValueOrDefault('%(RelativeDir)', '').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
