<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Acta.Postgres</RootNamespace>
    <Description>PostgreSQL provider for Acta: store, dialect, parameter binding, and migrations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acta\Acta.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Acta.Relational\Acta.Relational.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Acta.Generators\Acta.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Acta.Tests.Conformance.Postgres" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <!-- Provider-owned migrations, schema commands, feature SQL, and service SQL. -->
    <EmbeddedResource Include="Sql/**/*.sql;Schema/Migrations/**/*.sql" Exclude="$(DefaultItemExcludes)">
      <LogicalName>$(AssemblyName).$([MSBuild]::ValueOrDefault('%(RelativeDir)', '').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
