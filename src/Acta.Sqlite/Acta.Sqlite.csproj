<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Trim and AOT analyzers on: a registration that hides a constructor from the trimmer fails the build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Acta.Sqlite</RootNamespace>
    <Description>SQLite provider for Acta: embedded single-node stores, command binding, SQL, and migrations. Store commands run as inline SQL (no stored routines).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acta\Acta.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Acta.Generators\Acta.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Acta.Tests" />
    <InternalsVisibleTo Include="Anvil.Bench" />
    <InternalsVisibleTo Include="Acta.Tests.Conformance.Sqlite" />
    <!-- The one mixed-provider case (a SQLite outbox source relayed into a Postgres ledger) builds the
         internal SQLite source store through SqliteOutboxSource.CreateStore. -->
    <InternalsVisibleTo Include="Acta.Tests.Conformance.Postgres" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- The ordered migrations; every other SQL file lives beside its operation in Acta. -->
    <EmbeddedResource Include="Schema/Migrations/**/*.sql" Exclude="$(DefaultItemExcludes)">
      <LogicalName>$(AssemblyName).$([MSBuild]::ValueOrDefault('%(RelativeDir)', '').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
