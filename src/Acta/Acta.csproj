<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Trim and AOT analyzers on: a registration that hides a constructor from the trimmer fails the build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- One Acta namespace; folders group by operation group or capability. -->
    <RootNamespace>Acta</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <!-- Emit XML doc file so Acta.Emit can read summaries: JobPayloadFormat fields, and the entity and property
         summaries for docs/reference/data-model.md. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress "missing XML comment" warnings: not every public member needs one. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Acta: the [Job]/[JobSchedule] attributes, IJobs, JobContext, and code families, with the engine, its operations, database access, the schema, and hosting. Ships the source generator and ACTA analyzers; the provider packages bring the SQL dialect.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The generator/analyzer assembly rides this package (analyzers/dotnet/cs) so a single
         provider PackageReference gives consumers [Job] generation and ACTA diagnostics; analyzer
         assets flow transitively through package references, unlike ProjectReferences. -->
    <None
      Include="..\Acta.Generators\bin\$(Configuration)\netstandard2.0\Acta.Generators.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests need access to internal validators, canonicalizers, and helpers such as SchemaMigrations. -->
    <InternalsVisibleTo Include="Acta.Tests" />
    <!-- The test host stages a bounded group wait's expiry, which means finding the framework-owned
         deadline slot by the one reserved name JobContext writes it under. A copy of that name in the
         testing package could drift silently and make a staged expiry a no-op. It also composes internal
         runtime services for deterministic host control and diagnostics. -->
    <InternalsVisibleTo Include="Acta.Testing" />
    <!-- Conformance drives engine tuning that is deliberately not on the public surface: a bounce delay
         of 0, a batch size of 2, an alert delivery retry cap of 2. A spec proving the behaviour has to
         reach the knob a deployment must not. The provider conformance heads also build the internal
         outbox source store through the provider factory, so they must see the internal IOutboxRelayStore. -->
    <InternalsVisibleTo Include="Acta.Tests.Conformance" />
    <InternalsVisibleTo Include="Acta.Tests.Conformance.Postgres" />
    <InternalsVisibleTo Include="Acta.Tests.Conformance.SqlServer" />
    <InternalsVisibleTo Include="Acta.Tests.Conformance.Sqlite" />
    <!-- Provider assemblies implement the internal semantic store contracts without exposing those
         ports as public product API. -->
    <InternalsVisibleTo Include="Acta.Postgres" />
    <InternalsVisibleTo Include="Acta.SqlServer" />
    <InternalsVisibleTo Include="Acta.Sqlite" />
    <!-- The Redis wake transport composes the internal InProcessWakeup for its local delivery layer. -->
    <InternalsVisibleTo Include="Acta.Redis" />
    <!-- Code-emission tool reads the [DbTable]/[DbColumn] attribute graph and the ActaSchema metadata
         to render DDL and docs. -->
    <InternalsVisibleTo Include="Acta.Emit" />
    <!-- Acta Bench wraps IDbSession to inject faults after a store command commits. -->
    <InternalsVisibleTo Include="Acta.Bench" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every dialect's inline SQL beside its operation; the catalog selects one dialect by the X.<token>.sql
         suffix. Routine and operator-view bodies reach a database only inside a migration, so none is embedded. -->
    <EmbeddedResource Include="Operations/**/*.sql" Exclude="$(DefaultItemExcludes);Operations/**/*.routine.*.sql">
      <LogicalName>$(AssemblyName).$([MSBuild]::ValueOrDefault('%(RelativeDir)', '').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Packing without the generator assembly would ship a package whose [Job] source generation
       and ACTA analyzers silently never run; a build may proceed, a package must not. -->
  <Target Name="RequireGeneratorForPack" BeforeTargets="GenerateNuspec;Pack">
    <Error
      Condition="!Exists('..\Acta.Generators\bin\$(Configuration)\netstandard2.0\Acta.Generators.dll')"
      Text="Acta.Generators.dll is missing. Build src/Acta.Generators in $(Configuration) before packing Acta."
    />
  </Target>

  <ItemGroup>
    <!-- Generates the code families, the system-job manifest, the table binders, and the row projections. -->
    <ProjectReference Include="..\Acta.Generators\Acta.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Generated per-handler invokers call ActivatorUtilities.CreateInstance<T>(IServiceProvider).
         Carried transitively so consuming assemblies (concepts / user manifests) compile cleanly
         without an explicit reference. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Cron parsing for recurring schedules (6-field seconds support). Used by
         NextOccurrenceCalculator only, never in SQL. -->
    <PackageReference Include="Cronos" />
  </ItemGroup>
</Project>
