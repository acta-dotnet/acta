<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Trim and AOT analyzers on: a registration that hides a constructor from the trimmer fails the build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Acta.AspNetCore</RootNamespace>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Acta.AspNetCore maps the Acta HTTP API: query endpoints over IJobs, optional job-control endpoints over IJobs, and optional permission checks against the host's authorization policies. The host owns authentication.</Description>
    <PackageTags>jobs;background-jobs;durable-work-ledger;durable-execution;operations;aspnetcore;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Acta.Tests" />
    <InternalsVisibleTo Include="Acta.Dashboard" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Acta\Acta.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
