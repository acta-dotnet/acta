<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Trim and AOT analyzers on: a registration that hides a constructor from the trimmer fails the build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Acta.Runtime</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <!-- Emit XML doc file so Acta.Emit can read entity/property summaries for docs/reference/data-model.md. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress "missing XML comment" warnings: not every public member needs one. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>The Acta engine: operations, workers, database access, the schema and its migrations, and hosting. The provider packages bring the SQL dialect.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Cron parsing for recurring schedules (6-field seconds support). Used by
         NextOccurrenceCalculator only, never in SQL. -->
    <PackageReference Include="Cronos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acta\Acta.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests need access to internal helpers (e.g. SchemaMigrationDiscovery) for unit coverage. -->
    <InternalsVisibleTo Include="Acta.Tests" />
    <InternalsVisibleTo Include="Acta.Tests.Conformance" />
    <!-- The provider conformance heads build the internal outbox source store through the provider
         factory, so they must see the internal IOutboxRelayStore return type. -->
    <InternalsVisibleTo Include="Acta.Tests.Conformance.Postgres" />
    <InternalsVisibleTo Include="Acta.Tests.Conformance.SqlServer" />
    <InternalsVisibleTo Include="Acta.Tests.Conformance.Sqlite" />
    <!-- Provider assemblies implement the internal semantic store contracts without exposing those
         ports as public product API. -->
    <InternalsVisibleTo Include="Acta.Postgres" />
    <InternalsVisibleTo Include="Acta.SqlServer" />
    <InternalsVisibleTo Include="Acta.Sqlite" />
    <!-- The Redis wake transport composes the internal InProcessWakeup for its local delivery layer. -->
    <InternalsVisibleTo Include="Acta.Redis" />
    <!-- Code-emission tool reads the [DbTable]/[DbColumn] attribute graph and the ActaSchema metadata
         to render DDL and docs. -->
    <InternalsVisibleTo Include="Acta.Emit" />
    <!-- Acta.Testing composes internal runtime services for deterministic host control and diagnostics. -->
    <InternalsVisibleTo Include="Acta.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every dialect's SQL beside its operation, and the schema commands and operator views; the catalog
         selects one dialect by the X.<token>.sql suffix. -->
    <EmbeddedResource Include="Operations/**/*.sql;Schema/**/*.sql" Exclude="$(DefaultItemExcludes)">
      <LogicalName>$(AssemblyName).$([MSBuild]::ValueOrDefault('%(RelativeDir)', '').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Generates the system-job manifest, the table binders, and the row projections. -->
    <ProjectReference Include="..\Acta.Generators\Acta.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
