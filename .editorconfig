# CA1822: the eight private *CoreAsync catalog reads - ListTables, ListViews, ListColumns,
# ListIndexes, ListForeignKeys, ListCheckConstraints, ListCollationOverrides, CountTables. They exist
# only because SQL Server needs its reads wrapped in ReadCatalogAsync for the 1205 deadlock-victim
# retry, which is why this fixture is the one of the three that splits each read into a public member
# plus a private body. The bodies are the same code PgConformanceFixture and SqliteConformanceFixture
# keep as plain public instance methods, and none of the three touches instance state - all of them
# open a connection from a static connection string. Marking these eight static would leave the one
# fixture that had to be split as the only one whose catalog reads are static, to elide a `this` on a
# test path whose next statement opens a database connection.
[tests/Acta.Tests.Conformance.SqlServer/Testing/SqlServerConformanceFixture.cs]
dotnet_diagnostic.CA1822.severity = none

# CA1816: the DisposeAsync on each base is an xUnit IAsyncLifetime member, not a disposal API a
# caller reaches. xUnit v3 constructs the test class, awaits InitializeAsync, runs the test, awaits
# DisposeAsync once, and drops the reference; neither base declares a finalizer and neither can
# inherit one, because the derived types are conformance spec classes the runner instantiates.
# GC.SuppressFinalize(this) on an object with nothing to suppress is a no-op, and the benefit the
# rule states - sparing a derived type that adds a finalizer from re-implementing IDisposable - has
# no derived type here that could claim it.
[tests/Acta.Tests.Conformance/Testing/{ActaTestBase.cs,IntegrationSpec.cs}]
dotnet_diagnostic.CA1816.severity = none

