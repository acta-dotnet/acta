# CA1819: VariableRaceResult.ObservedValues, an int[] on a probe result record. The record is the
# handler's return value, serialized to JSON as the job result and deserialized by the spec that
# asserts on it - it is a wire shape, so there is no encapsulated state to defend and every read is
# the one read.
# CA1820: the `== string.Empty` inside VariableRoundTripResult's string block. That block is a table
# of round-trip assertions written as one chained expression - whitespace, punctuation, non-Latin
# script, emoji - each proving a stored variable comes back identical, and the empty string is one
# row of it. Both replacements the rule offers are worse here: .Length == 0 breaks the table into two
# shapes, and IsNullOrEmpty would also accept null, which is precisely the round-trip failure this
# row exists to catch.
[tests/Acta.Tests.TestJobs/JobVariableProbes.cs]
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1820.severity = none
