# signal. Giving it a method to satisfy the rule would put a member on every meta-spec that nothing
# calls, which is the dead code CA1040 is trying to prevent, one level up.
[tests/Acta.Tests.Conformance/Contracts/IConformanceMetaSpec.cs]
dotnet_diagnostic.CA1040.severity = none

