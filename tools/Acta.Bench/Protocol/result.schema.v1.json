{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Anvil result envelope",
  "$comment": "Shape validation is not verification of engine results. Semantic reconciliation and required-plan coverage checks are additionally mandatory.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "evidence_kind",
    "status",
    "provenance",
    "scope",
    "coverage",
    "durability",
    "cases",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "acta-bench.result/1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "enum": [
        "real_execution",
        "synthetic_harness_test"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "ABORTED"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "protocol_id",
        "protocol_sha256",
        "plan_sha256",
        "source_commit",
        "source_dirty",
        "binary_sha256",
        "environment_file"
      ],
      "properties": {
        "protocol_id": {
          "type": "string"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "source_dirty": {
          "type": "boolean"
        },
        "binary_sha256": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "environment_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "requested_providers",
        "completed_providers",
        "excluded_fault_classes"
      ],
      "properties": {
        "requested_providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "completed_providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excluded_fault_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "required_instances",
        "passed_instances",
        "failed_instances",
        "unresolved_required_instances"
      ],
      "properties": {
        "required_instances": {
          "type": "integer",
          "minimum": 0
        },
        "passed_instances": {
          "type": "integer",
          "minimum": 0
        },
        "failed_instances": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_required_instances": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "durability": {
      "type": "object",
      "required": [
        "track",
        "settings_verified",
        "physical_power_loss_tested"
      ],
      "properties": {
        "track": {
          "enum": [
            "single_node_durable",
            "synchronously_replicated",
            "unsafe_diagnostic"
          ]
        },
        "settings_verified": {
          "type": "boolean"
        },
        "physical_power_loss_tested": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "phase",
          "repetition",
          "status",
          "reason",
          "safety",
          "liveness",
          "coverage",
          "measurement",
          "metrics",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}$"
          },
          "provider": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "self_test",
              "verify",
              "discover",
              "measure",
              "fault",
              "soak",
              "reconcile"
            ]
          },
          "repetition": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "NOT_APPLICABLE"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "safety": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED",
              "NOT_APPLICABLE"
            ]
          },
          "liveness": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED",
              "NOT_APPLICABLE"
            ]
          },
          "coverage": {
            "enum": [
              "COMPLETE",
              "INCOMPLETE",
              "NOT_APPLICABLE"
            ]
          },
          "measurement": {
            "enum": [
              "VALID",
              "UNSTABLE",
              "GENERATOR_LIMITED",
              "OBSERVER_LIMITED",
              "UNAVAILABLE",
              "NOT_MEASURED"
            ]
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "value",
                "unit",
                "status",
                "reason"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "MEASURED",
                    "UNAVAILABLE",
                    "LOW_SAMPLE",
                    "INVALID"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "UNAVAILABLE",
                          "INVALID"
                        ]
                      }
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "native_topology": {
            "type": "string"
          },
          "instrumented": {
            "type": "boolean"
          },
          "diagnostic_cell_name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "safety": {
                  "const": "PASS"
                },
                "liveness": {
                  "enum": [
                    "PASS",
                    "NOT_APPLICABLE"
                  ]
                },
                "coverage": {
                  "const": "COMPLETE"
                },
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "INCONCLUSIVE",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "failed_instances": {
                "const": 0
              },
              "unresolved_required_instances": {
                "const": 0
              }
            }
          },
          "cases": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
