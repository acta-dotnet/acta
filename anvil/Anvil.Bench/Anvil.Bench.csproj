<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Anvil.Bench</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <!-- Must stay false: Microsoft.Data.SqlClient throws "Globalization Invariant Mode is not supported"
         at startup, so the SQL Server provider path needs ICU. Costs a few MB in the AOT binary. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <!-- Build-time AOT/trim analysis so reflection is caught without the native linker (CI does the link). -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Reflection-free JSON: BenchPayloadJsonContext (wired via j.UseJsonPayloads) supplies source-gen
         metadata for the workload payload types, so enqueue serialization needs no reflection under AOT. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The three bench jobs (bench-run/bench-audit/bench-block) deliberately share BenchInput and are
         always enqueued via the raw JobEnqueueRequest path, which names the job, so the typed-route
         ambiguity ACTA0104 flags never applies here. -->
    <NoWarn>$(NoWarn);ACTA0104;IDE0011</NoWarn>
    <!-- Microsoft.Data.SqlClient (SQL Server provider) is not AOT/trim-clean, and SQL Server is not an
         AOT target - Postgres and SQLite are. Keep its per-assembly trim (IL2104) and AOT (IL3053)
         rollup warnings visible but non-fatal so the guardrail still proves our code plus the PG/SQLite
         paths compile natively. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\..\src\Acta.Generators\Acta.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference Include="..\..\src\Acta\Acta.csproj" />
    <ProjectReference Include="..\..\src\Acta.Contracts\Acta.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Acta.Redis\Acta.Redis.csproj" />
    <ProjectReference Include="..\..\support\Acta.LocalHost\Acta.LocalHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Bench opens its own connections for the per-cell schema reset and purge/retention row ops. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
</Project>
