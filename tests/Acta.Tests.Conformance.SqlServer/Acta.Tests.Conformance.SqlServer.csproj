<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Acta.Tests.Conformance.SqlServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Acta.Tests.Conformance is a class library (NOT IsTestProject) holding the shared test
         infrastructure; the shared specs compile into this project instead (the Compile items below).
         The library shape avoids the CS0436 SelfRegisteredExtensions duplicate that surfaces when two
         IsTestProject=true assemblies reference each other. -->
    <ProjectReference Include="..\Acta.Tests.Conformance\Acta.Tests.Conformance.csproj" />
    <ProjectReference Include="..\..\src\Acta.SqlServer\Acta.SqlServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared specs, bound to this provider by the ConformanceFixture alias in GlobalUsings.cs. -->
    <Compile Include="..\Acta.Tests.Conformance\GlobalUsings.cs" Link="Shared\GlobalUsings.cs" />
    <Compile Include="..\Acta.Tests.Conformance\DbSession\**\*.cs" LinkBase="Shared\DbSession" />
    <Compile Include="..\Acta.Tests.Conformance\Features\**\*.cs" LinkBase="Shared\Features" />
    <Compile Include="..\Acta.Tests.Conformance\Runtime\**\*.cs" LinkBase="Shared\Runtime" />
    <Compile Include="..\Acta.Tests.Conformance\Scenarios\**\*.cs" LinkBase="Shared\Scenarios" />
  </ItemGroup>
</Project>
