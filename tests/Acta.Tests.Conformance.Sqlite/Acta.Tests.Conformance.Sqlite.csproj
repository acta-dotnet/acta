<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Acta.Tests.Conformance.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acta.Tests.Conformance\Acta.Tests.Conformance.csproj" />
    <ProjectReference Include="..\..\src\Acta.Sqlite\Acta.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared specs, bound to this provider by the ConformanceFixture alias in GlobalUsings.cs. -->
    <Compile Include="..\Acta.Tests.Conformance\GlobalUsings.cs" Link="Shared\GlobalUsings.cs" />
    <Compile Include="..\Acta.Tests.Conformance\Storage\**\*.cs" LinkBase="Shared\Storage" />
    <Compile Include="..\Acta.Tests.Conformance\Engine\**\*.cs" LinkBase="Shared\Engine" />
    <Compile Include="..\Acta.Tests.Conformance\Operations\**\*.cs" LinkBase="Shared\Operations" />
    <Compile Include="..\Acta.Tests.Conformance\Scenarios\**\*.cs" LinkBase="Shared\Scenarios" />
    <Compile Include="..\Acta.Tests.Conformance\Schema\**\*.cs" LinkBase="Shared\Schema" />
  </ItemGroup>
</Project>
