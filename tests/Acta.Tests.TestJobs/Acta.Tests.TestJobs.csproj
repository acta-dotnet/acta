<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TestJobs</RootNamespace>
    <!-- Emit generator output to disk so the manifest is human-inspectable. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj\$(Configuration)\$(TargetFramework)\generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Job descriptors + IActaManifest contract come from Abstractions. -->
    <ProjectReference Include="..\..\src\Acta\Acta.csproj" />
    <!-- Generator emits TestJobs.TestJobsManifest at compile time. -->
    <ProjectReference
      Include="..\..\src\Acta.Generators\Acta.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
