<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Private packages folder so a re-run never resolves a stale cached Acta package from the user profile. -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local-feed" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- The smoke contract: Acta.* must come from the freshly packed local feed, never a same-named
       package from nuget.org. Third-party deps still resolve from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="local-feed">
      <package pattern="Acta" />
      <package pattern="Acta.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
