<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The sample declares `namespace Shipping;`, so the generated manifest belongs there too. -->
    <RootNamespace>Shipping</RootNamespace>
    <ActaPackageVersion Condition="'$(ActaPackageVersion)' == ''">*-*</ActaPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The smallest honest set: the webhook handler needs [Job], JobContext, and the generator,
         all of which ride the Acta package. No provider, no host. HttpClient is the BCL's, so the
         sample's only undeclared dependency is one a newcomer already has. -->
    <PackageReference Include="Acta" Version="$(ActaPackageVersion)" />
  </ItemGroup>
</Project>
