<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Held at 5.3.0 on purpose, not stale. This is the Roslyn the source generator compiles
         against, and that version is the floor on the SDK a consumer needs to load it. Newer buys
         nothing here - no API in 5.4+ is used - and costs every consumer on an older 10.0.1xx SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
  </ItemGroup>
  <!-- Build-time only: derives the package version from git tags (see Directory.Build.props). -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>
  <!-- Hosting + DI/Options surface. Acta depends on DI/Options abstractions to define
       UseActa(IServiceCollection); consumers bring the full Hosting. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
  </ItemGroup>
  <!-- DB clients used by the provider migration runners + parameter binders. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <!-- Redis client for the Acta.Redis wake transport. -->
  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
  </ItemGroup>
  <!-- In-process host for Acta.AspNetCore endpoint tests. OpenApi is a test-only reference on
       purpose: the committed contract is generated and drift-checked by a test, so the shipped
       Acta.AspNetCore package carries no OpenAPI dependency for hosts that do not want one. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Test-only: validates definitions against the published calendar schema, to hold the schema to the compiler. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
  </ItemGroup>
  <!-- Testing: xunit v3. Held at 3.2.2: xunit 4 runs only on Microsoft.Testing.Platform, and moving the
       suites, the runsettings, and CI onto it is a change of its own. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Attributes-only facade for shared spec libraries that aren't themselves test runners.
         Avoids the Microsoft.Testing.Platform.MSBuild transitive that emits
         AutoRegisteredExtensions.cs (the source of CS0436 duplicates on cross-project import). -->
    <PackageVersion Include="xunit.v3.core" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
