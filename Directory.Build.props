<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Warnings are errors solution-wide so doc-comment cref rot, unused usings, and style drift cannot
         accumulate. Per-project NoWarn (e.g. the Acta SDK's 1591) still applies. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!-- Curated analyzer tier, on unconditionally: the built-in Roslyn/.NET analyzers report their full
       rule set without adding analyzer packages, and the families that contradict a deliberate Acta
       convention are switched off below with their reason. This is deliberately not an opt-in profile.
       A /p: flag that no CI job passes is aspirational config that rots, so the gate is the default
       build or it is not a gate. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <!-- Permanent suppressions. Each rule here asks for a change Acta has deliberately decided against,
       so it is turned off with its reason recorded rather than satisfied in code. -->
  <PropertyGroup>
    <!-- Canonical identifiers, deduplication keys, slugs, and operator-facing tokens are lowercase
         ASCII by design; CA1308's uppercase-normalization guidance conflicts with that. -->
    <NoWarn>$(NoWarn);CA1308</NoWarn>
    <!-- Code-family and transport enums intentionally use byte/short backing types to match persisted
         catalog/storage widths; CA1028's int guidance conflicts with that contract. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- Acta only ever runs in ASP.NET Core and generic-host workers, neither of which installs a
         SynchronizationContext, so CA2007's ConfigureAwait(false) has nothing here to guard against. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- The specs name behaviour as Given_When_Then sentences on purpose, because the test name is the
         failure message a maintainer reads; CA1707's no-underscores rule conflicts with that. -->
    <NoWarn Condition="'$(MSBuildProjectDirectory.Contains(`\tests\`))' == 'true'">$(NoWarn);CA1707</NoWarn>
    <!-- xUnit and BenchmarkDotNet discover fixtures, theory data, and benchmark classes by reflection
         and require them public; CA1515's internal-by-default guidance breaks that discovery. -->
    <NoWarn Condition="'$(MSBuildProjectDirectory.Contains(`\tests\`))' == 'true' or '$(MSBuildProjectDirectory.Contains(`\anvil\`))' == 'true'">$(NoWarn);CA1515</NoWarn>
    <!-- Suppressed for spec and harness code only, where these are Assert.Contains/StartsWith over test
         literals. NOT suppressed in src: an ASCII protocol token is a reason to be MORE explicit about
         ordinal comparison, not less - the default overloads are culture-sensitive, and a Turkish-locale
         dotless i changes what "I".ToLower() produces. The src sites are A3 work, not a convention. -->
    <NoWarn Condition="'$(MSBuildProjectDirectory.Contains(`\tests\`))' == 'true' or '$(MSBuildProjectDirectory.Contains(`\anvil\`))' == 'true'">$(NoWarn);CA1307;CA1310</NoWarn>
    <!-- Only the three Extensible code families carry a zero member, named Unspecified because the
         catalog defines it as the forward-read sentinel. The other 22 families deliberately have no
         zero value: the schema emits a CHECK IN (...) list for them, so an out-of-family id cannot be
         persisted, and a sentinel would invent a state the ledger has no row shape for. CA1008 cannot
         see that constraint. -->
    <NoWarn>$(NoWarn);CA1008</NoWarn>
    <!-- URL-shaped values such as runbook_url_override are persisted varchar columns that travel as
         strings on the wire, so CA1054/CA1055/CA1056 would change a persisted and public contract to
         satisfy an analyzer. CA2234 is a different rule - it asks a call site to select a Uri overload
         and changes no signature - but the value in hand is that same persisted string, so converting
         it at the boundary only to hand it back would add a parse that can throw on data the ledger
         already accepted. -->
    <NoWarn>$(NoWarn);CA2234;CA1054;CA1055;CA1056</NoWarn>
    <!-- Acta's exceptions carry required evidence - the job ref, the key, the exhausted budget - and
         deliberately omit the parameterless and message-only constructors so a caller cannot throw one
         without the context it exists to carry; CA1032 asks for exactly those constructors. -->
    <NoWarn>$(NoWarn);CA1032</NoWarn>
    <!-- RaiseSignalAsync and its siblings are durable ledger operations named as verbs, not CLR
         events; CA1030's event-shaped guidance does not describe them. -->
    <NoWarn>$(NoWarn);CA1030</NoWarn>
    <!-- The only Random use is retry backoff and claim-poll jitter, where spreading load is the point
         and unpredictability is not a security property; CA5394 reads it as a cryptographic concern. -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
    <!-- Two different rules, suppressed for one reason. CA1848 wants LoggerMessage delegates, which
         would restructure ~71 call sites for allocations Acta's sparse, mostly-Debug logging does not
         make at volume. CA1873 is narrower - it warns that an expensive argument is evaluated even when
         the level is disabled - and the flagged arguments here are field reads and already-materialised
         strings, not computation. Revisit CA1873 if a log line ever takes a computed argument. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
    <!-- Acta ships no resource files and no localization story; operator messages, exception text and
         log templates are deliberately English-only, so CA1303 presumes a product Acta is not. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
    <!-- Every site is DbDataReader.IsDBNull on a row already buffered by an awaited ReadAsync, and no
         reader opens with CommandBehavior.SequentialAccess, so there is no I/O for the async form to
         overlap. Awaiting it per column adds a task allocation and continuation on a path that reads
         columns in a tight loop; the method already has its one state machine either way. CA1849 is
         wrong here rather than tolerated. -->
    <NoWarn>$(NoWarn);CA1849</NoWarn>
    <!-- Suppressed for spec and harness code only, where the sites are Task-returning test helpers and
         Anvil mappers. Interface-typed internals are a deliberate readability choice there and the
         dispatch saving is unmeasurable. NOT suppressed in src, so a future hit on the claim or execute
         path is reported rather than silently inherited. -->
    <NoWarn Condition="'$(MSBuildProjectDirectory.Contains(`\tests\`))' == 'true' or '$(MSBuildProjectDirectory.Contains(`\anvil\`))' == 'true' or '$(MSBuildProjectDirectory.Contains(`\support\`))' == 'true'">$(NoWarn);CA1859</NoWarn>
  </PropertyGroup>

  <!-- TEMPORARY - Track A3 debt. These are real findings, not conventions Acta disagrees with. They are
       parked here, unfixed, because TreatWarningsAsErrors is global: the alternative to parking them was
       to keep the whole curated tier switched off until all of them were fixed, which is how the tier
       stayed off for a year. Parking is the lesser evil and is explicitly not a ruling on any of them.
       Each rule is deleted from this list as its A3 slice lands, and the block goes with the last one.
       Counts are distinct sites (file, line, column) measured on 58f61c0 and are the slice sizes:
         CA1062  128  null validation on public entry points
         CA2000  118  disposable not disposed along every path
         CA2100   92  CommandText built from possibly-tainted input - the reason Track A is in rc.1
         CA1031   62  general exception boundaries
         CA1508   10  provably-dead branches - parked, not ruled on. When its slice lands, inspect each
                      site: they are all (object?)row.X is-never-null in DB row mappers and may be
                      legitimate defence against nullability the compiler cannot see. No blanket rule.
         CA1001    4  types owning disposable fields without IDisposable
         CA2213    3  owned disposable fields never disposed -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1062;CA2000;CA2100;CA1031;CA1508;CA1001;CA2213</NoWarn>
  </PropertyGroup>

  <!-- TEMPORARY - Track A3 fixes that are agreed but not yet written. Each rule leaves this list as
       its slice lands, and the block goes with the last one. Distinct sites measured on 58f61c0:
         CA1305   18  int.Parse/double.Parse without InvariantCulture, in Anvil (14) and Acta.Emit (4).
                      A real locale bug: on a comma-decimal locale double.Parse("1.5") misparses, and
                      Anvil is the certification harness whose numbers gate the release.
         CA2208    9  ArgumentException given a paramName that is not a parameter.
         CA1068    5  CancellationToken not last. All internal - IJobs already has it last on both
                      public RaiseSignalAsync overloads; the odd one out is a third overload that
                      exists only on the internal JobsApi with actorKey and ct transposed.
         CA1812    1  NoOpWakeup in BenchHost.cs is never instantiated - delete it.
         CA1307   18  Culture-sensitive Replace/Contains/IndexOf in src and tools, unmasked by scoping
                      CA1307 away from the spec suppression above. These are real: Replace(string,
                      string) and Contains(string) ARE culture-sensitive, and the sites are identifier,
                      SQL-text and migration-name handling - exactly where a Turkish-locale dotless i
                      would change behaviour. Add StringComparison.Ordinal per site. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1305;CA2208;CA1068;CA1812</NoWarn>
    <NoWarn Condition="'$(MSBuildProjectDirectory.Contains(`\src\`))' == 'true' or '$(MSBuildProjectDirectory.Contains(`\tools\`))' == 'true'">$(NoWarn);CA1307;CA1310</NoWarn>
    <!-- CA1859, 3 sites, also unmasked by scoping: NormalizeTags and SnapshotTags in src return
         IReadOnlyList<TagInput>? where the concrete array would avoid an interface dispatch, and
         CodeFamiliesUsed in the emitter is the same shape. Unlike the spec-helper sites the src pair is
         on the enqueue path, so they are worth taking rather than ruling away - as their own change,
         with the perf claim actually checked. -->
    <NoWarn Condition="'$(MSBuildProjectDirectory.Contains(`\src\`))' == 'true' or '$(MSBuildProjectDirectory.Contains(`\tools\`))' == 'true'">$(NoWarn);CA1859</NoWarn>
  </PropertyGroup>

  <!-- TEMPORARY - the long tail: ~64 sites across the 17 rules listed below, at 1-9 each, still to be
       read per site and either fixed or moved above with a reason. No ruling has been made on any of
       them; the count of rules here must match the list. Some are probably real and small (CA1823
       unused fields, CA1816 missing GC.SuppressFinalize); most look like pure style. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1822;CA1034;CA1064;CA1861;CA2225;CA1875;CA1819;CA1823;CA1816;CA1805</NoWarn>
    <NoWarn>$(NoWarn);CA1716;CA1711;CA1820;CA1815;CA1050;CA1040;CA1024</NoWarn>
  </PropertyGroup>

  <!-- Shared NuGet metadata; only the packable src libraries emit it at pack time. -->
  <PropertyGroup>
    <Authors>Marko Voncina</Authors>
    <Company>useacta</Company>
    <Product>Acta</Product>
    <PackageTags>jobs;background-jobs;durable-work-ledger;durable-execution;workflow;sql;postgres;sqlserver;sqlite;dotnet;aot</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/acta-dotnet/acta</PackageProjectUrl>
    <RepositoryUrl>https://github.com/acta-dotnet/acta</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Reproducible builds + SourceLink so the shipped snupkg resolves original sources. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Pack the repo README into every library so nuget.org renders a description tab. The metadata
       and the packed file are gated on the same condition so they cannot drift into an NU5039. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The durability contract as do-this-not-that pairs, for a coding agent that has Acta in front
       of it but only Hangfire/Quartz idioms in its weights. Those idioms compile here and are wrong
       here, and the compiler cannot say so; shipping the text where the package is read can. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)llms.txt')">
    <None Include="$(MSBuildThisFileDirectory)llms.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
