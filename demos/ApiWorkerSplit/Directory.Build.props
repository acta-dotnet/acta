<Project>
  <!-- Shared build settings only. Every Acta package a project uses is named in that project's own
       csproj, so nothing about its dependencies is hidden here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
