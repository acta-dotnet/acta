<Project>
  <!-- The demos consume Acta the way an outside app does: published packages, no project references
       into src/. Only the Acta versions live here; importing the root file keeps every incidental
       dependency centrally managed. Bump these after each publish (docs/internals/releasing.md). -->
  <Import Project="../Directory.Packages.props" />
  <ItemGroup>
    <PackageVersion Include="Acta" Version="1.0.0-rc.2" />
    <PackageVersion Include="Acta.AspNetCore" Version="1.0.0-rc.2" />
    <PackageVersion Include="Acta.Postgres" Version="1.0.0-rc.2" />
    <PackageVersion Include="Acta.SqlServer" Version="1.0.0-rc.2" />
    <PackageVersion Include="Acta.Sqlite" Version="1.0.0-rc.2" />
  </ItemGroup>
</Project>
